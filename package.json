{
  "name": "evalkit",
  "version": "1.0.0",
  "description": "Evaluate LLM prompts and models with statistically rigorous comparisons",
  "type": "module",
  "bin": {
    "evalkit": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sanity": "tsx --env-file=.env scripts/sanity.ts",
    "hdb:setup": "tsx examples/hdb/setup.ts",
    "try:model": "tsx --env-file=.env scripts/try-model.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealfromdowntown/EvalKit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sealfromdowntown/EvalKit/issues"
  },
  "homepage": "https://github.com/sealfromdowntown/EvalKit#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "openai": "^7.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
